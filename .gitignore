# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Entornos virtuales
venv/
.venv/
env/
ENV/

# Empaquetado
build/
dist/
*.egg-info/
.eggs/

# Temporales de pip (se crean al instalar en entornos con restricciones)
.pip-tmp/

# Herramientas de edicion
.vscode/
.idea/
*.swp
*~

# Sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Registros y volcados de las pruebas
*.log
qr_consola.txt
qr_check.png

# Ajustes locales (por ejemplo, si se quito el codigo de acceso). Cada persona
# decide el suyo con quitar-codigo.bat o activar-codigo.bat, asi que no se
# versiona.
server/config.json

# Accesos de los dispositivos ya autorizados (tokens). Es un secreto local de
# cada equipo: no se versiona.
server/tokens.json

# Preferencias de cada dispositivo (perfil del usuario).
server/profiles.json

# Lo que la PC ha aprendido de tu forma de usar el puntero.
server/learning.json

# Programas usados en la PC (historial para abrirlos desde el celular).
server/history.json

# Ajustes de la app de escritorio (puerto, red, arranque) y su salida de consola.
# Los registros (servidor.log) ya estan cubiertos por *.log.
server/escritorio.json
server/consola.log

# Secretos y configuracion local (no deberia haber, pero por si acaso)
*.local
.env

# Capturas de las pruebas de interfaz con el navegador
.playwright-mcp/

# Certificados de HTTPS (--https): la clave privada es un secreto local.
server/https/
